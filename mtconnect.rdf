<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
	<!ENTITY AnnotationVocabulary "https://www.omg.org/spec/Commons/AnnotationVocabulary/">
	<!ENTITY anno "https://spec.industrialontologies.org/ontology/annotation/">
	<!ENTITY dc "http://purl.org/dc/elements/1.1/">
	<!ENTITY owl "http://www.w3.org/2002/07/owl#">
	<!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
	<!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
	<!ENTITY skos "http://www.w3.org/2004/02/skos/core#">
	<!ENTITY terms "http://purl.org/dc/terms/">
	<!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
]>
<rdf:RDF
	xmlns="https://onto.mtconnect.org/ontology/construct/"
	xmlns:AnnotationVocabulary="https://www.omg.org/spec/Commons/AnnotationVocabulary/"
	xmlns:anno="https://spec.industrialontologies.org/ontology/annotation/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:owl="http://www.w3.org/2002/07/owl#"
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
	xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
	xmlns:skos="http://www.w3.org/2004/02/skos/core#"
	xmlns:terms="http://purl.org/dc/terms/"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
	
	<owl:Ontology rdf:about="https://onto.mtconnect.org/ontology/construct">
		<owl:imports rdf:resource="https://spec.industrialontologies.org/ontology/core/Core"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Designators"/>
	</owl:Ontology>
	
	<owl:Class rdf:about="http://qudt.org/vocab/unit/Unit">
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/ARotaryAxisRole">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/RotaryAxisRole"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">A Rotary Axis Role</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/ARotaryMotionSystemRole">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/RotaryMotionSystemRole"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">A Rotary Motion System Role</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Actuator">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Actuator</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Angle">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Angle</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/BRotaryAxisRole">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/RotaryAxisRole"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">B Rotary Axis Role</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/BRotaryMotionSystemRole">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/RotaryMotionSystemRole"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">B Rotary Motion System Role</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Ballscrew">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasRole"/>
				<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EquipmentRole"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Ballscrew</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/CRotaryAxisRole">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/RotaryAxisRole"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">C Rotary Axis Role</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/CRotaryMotionSystemRole">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/RotaryMotionSystemRole"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">C Rotary Motion System Role</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Chuck">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasRole"/>
				<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EquipmentRole"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Chuck</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/ChuckState">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/State"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Chuck State</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/ContinuousRevoluteCapability">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/RevoluteMotionCapability"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Continuous Revolute Capability</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/ControlSystem">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Control System</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/ControlSystemPath">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/ControlSystem"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Control System Path</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/ControllerMode">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/State"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Controller Mode</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/CoolantSystem">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Coolant System</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Displacement">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Displacement</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/DispositionToBePartOfSystem">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/RelationalDisposition"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://onto.mtconnect.org/ontology/construct/targetOf"/>
				<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/System"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&xsd;string">disposition to be part of system</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Door">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasRole"/>
				<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EquipmentRole"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Door</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/ElectricalSystem">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Electrical System</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Enclosure">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/Structure"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasRole"/>
				<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EquipmentRole"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Enclosure</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/ExecutionState">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/State"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Execution State</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/FiveAxisMotionCapability">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/FourAxisMotionCapability"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Five Axis Motion Capability</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://onto.mtconnect.org/ontology/construct/FourAxisMotionCapability">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/capabilityOf"/>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="https://onto.mtconnect.org/ontology/construct/Machine">
									</rdf:Description>
									<owl:Restriction>
										<owl:onProperty rdf:resource="https://onto.mtconnect.org/ontology/construct/hasComponent"/>
										<owl:onClass>
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<rdf:Description rdf:about="https://onto.mtconnect.org/ontology/construct/RotaryMotionSystem">
													</rdf:Description>
													<owl:Restriction>
														<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasFunction"/>
														<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/IndexedRevoluteCapability"/>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
										</owl:onClass>
										<owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">2</owl:minQualifiedCardinality>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Force">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Force</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/FourAxisMotionCapability">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/ThreeAxisMotionCapability"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Four Axis Motion Capability</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://onto.mtconnect.org/ontology/construct/ThreeAxisMotionCapability">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/capabilityOf"/>
						<owl:someValuesFrom>
							<owl:Class>
								<owl:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="https://onto.mtconnect.org/ontology/construct/Machine">
									</rdf:Description>
									<owl:Restriction>
										<owl:onProperty rdf:resource="https://onto.mtconnect.org/ontology/construct/hasComponent"/>
										<owl:someValuesFrom>
											<owl:Class>
												<owl:intersectionOf rdf:parseType="Collection">
													<rdf:Description rdf:about="https://onto.mtconnect.org/ontology/construct/RotaryMotionSystem">
													</rdf:Description>
													<owl:Restriction>
														<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasFunction"/>
														<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/IndexedRevoluteCapability"/>
													</owl:Restriction>
												</owl:intersectionOf>
											</owl:Class>
										</owl:someValuesFrom>
									</owl:Restriction>
								</owl:intersectionOf>
							</owl:Class>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/HydraulicSystem">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Hydraulic System</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/IndexedRevoluteCapability">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/RevoluteMotionCapability"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Indexed Revolute Capability</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Length">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Length</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/LinearAxisRole">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/RelationalRole"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://onto.mtconnect.org/ontology/construct/targetOf"/>
				<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/Machine"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/roleOf"/>
				<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/LinearMotionSystem"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Linear Axis Role</rdfs:label>
		<owl:disjointWith rdf:resource="https://onto.mtconnect.org/ontology/construct/RotaryAxisRole"/>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/LinearMotionSystem">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/MotionSystem"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Linear Motion System</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasCapability"/>
						<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/PrismaticMotionCapability"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes"/>
						<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/Ballscrew"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasRole"/>
						<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/LinearMotionSystemRole"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/LinearMotionSystemRole">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/MotionSystemRole"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Linear Motion System Role</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/LubricationSystem">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Lubrication System</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Machine">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasCapability"/>
				<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Capability"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtSomeTime"/>
				<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/MotionSystem"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasRole"/>
				<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EquipmentRole"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Machine</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/MillingCapability">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Capability"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Milling Capability</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/MotionCapability">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Capability"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Motion Capability</rdfs:label>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/Capability">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/capabilityOf"/>
						<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/Actuator"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/MotionSystem">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Motion System</rdfs:label>
		<owl:equivalentClass>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasCapability"/>
				<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/MotionCapability"/>
			</owl:Restriction>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/MotionSystemRole">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Motion System Role</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/Motor">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/Actuator"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasRole"/>
				<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/EquipmentRole"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Motor</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/NumericallyControlledMachine">
		<rdfs:subClassOf rdf:resource="https://onto.mtconnect.org/ontology/construct/Machine"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtSomeTime"/>
				<owl:someValuesFrom rdf:resource="https://onto.mtconnect.org/ontology/construct/ControlSystem"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">Numerically Controlled Machine</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="https://onto.mtconnect.org/ontology/construct/PneumaticSystem">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
