	<owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000182">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">history</rdfs:label>
		<dc:identifier rdf:datatype="&xs;string">138-BFO</dc:identifier>
		<skos:definition rdf:datatype="&rdf;langString" xml:lang="en">(Elucidation) A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by the material part of a material entity</skos:definition>
		<skos:example rdf:datatype="&rdf;langString" xml:lang="en">The life of an organism from the beginning to the end of its existence.</skos:example>
		<skos:prefLabel rdf:datatype="&rdf;langString" xml:lang="en">history</skos:prefLabel>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000183">
