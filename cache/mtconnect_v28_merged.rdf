	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_ACTUATOR">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">ACTUATOR</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that moves or controls a mechanical part of a piece of equipment.

It takes energy usually provided by air, electric current, or liquid and converts the energy into some kind of motion.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_AMPLIFIER">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">AMPLIFIER</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of an electronic component or circuit that amplifies power, electric current, or voltage.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_BALLSCREW">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">BALLSCREW</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanical structure that transforms rotary motion into linear motion.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_BELT">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">BELT</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of an endless flexible band that transmits motion for a piece of equipment or conveys materials and objects.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_BRAKE">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">BRAKE</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that slows down or stops a moving object by the absorption or transfer of the energy of momentum, usually by means of friction, electrical force, or magnetic force.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_CHAIN">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">CHAIN</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of an interconnected series of objects that band together and transmit motion for a piece of equipment or to convey materials and objects.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_CHOPPER">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">CHOPPER</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that breaks material into smaller pieces.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_CHUCK">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">CHUCK</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that holds a part, stock material, or any other item in place.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_CHUTE">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">CHUTE</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of an inclined channel that conveys material.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_CIRCUITBREAKER">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">CIRCUIT_BREAKER</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that interrupts an electric circuit.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_CLAMP">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">CLAMP</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that strengthens, supports, or fastens objects in place.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_COMPRESSOR">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">COMPRESSOR</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a pump or other mechanism that reduces volume and increases pressure of gases in order to condense the gases to drive pneumatically powered pieces of equipment.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_COOLINGTOWER">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">COOLING_TOWER</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a heat exchange system that uses a fluid to transfer heat to the atmosphere.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_DOOR">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">DOOR</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanical mechanism or closure that covers a physical access portal into a piece of equipment allowing or restricting access to other parts of the equipment.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_DRAIN">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">DRAIN</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that allows material to flow for the purpose of drainage from, for example, a vessel or tank.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_ENCODER">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">ENCODER</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that measures rotary position.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_EXPIREDPOT">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">EXPIRED_POT</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">pot for a tool that is no longer usable for removal from a tool magazine or turret.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_EXPOSUREUNIT">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">EXPOSURE_UNIT</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that emits a type of radiation.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_EXTRUSIONUNIT">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">EXTRUSION_UNIT</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that dispenses liquid or powered materials.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_FAN">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">FAN</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that produces a current of air.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_FILTER">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">FILTER</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a substance or structure that allows liquids or gases to pass through to remove suspended impurities or to recover solids.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_GALVANOMOTOR">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">GALVANOMOTOR</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of an electromechanical actuator that produces deflection of a beam of light or energy in response to electric current through its coil in a magnetic field.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_GRIPPER">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">GRIPPER</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that holds a part, stock material, or any other item in place.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_HOPPER">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">HOPPER</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a chamber or bin that stores materials temporarily, typically being filled through the top and dispensed through the bottom.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_LINEARPOSITIONFEEDBACK">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">LINEAR_POSITION_FEEDBACK</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that measures linear motion or position.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_MOTOR">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">MOTOR</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a mechanism that converts electrical, pneumatic, or hydraulic energy into mechanical energy.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_OIL">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">OIL</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a viscous liquid.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_POT">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">POT</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a tool storage location associated with a tool magazine or automatic tool changer.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionTypeEnum_POWERSUPPLY">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">POWER_SUPPLY</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">composition composed of a unit that provides power to electric mechanisms.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
