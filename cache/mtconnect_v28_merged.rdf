		<rdfs:range rdf:resource="&mtc-cnstr;DataItemTypeEnum"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">{{property(DataItem::type)}} that defines the meaning of {{property(CellDefinition::key)}}.</iof-av:naturalLanguageDefinition>
	</owl:ObjectProperty>
	
