		<rdfs:label rdf:datatype="&xs;string">HF</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">distance from the basal plane of the tool item to the cutting point.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_IC">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">IC</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">diameter of a circle to which all edges of a equilateral and round regular insert are tangential.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_KAPR">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">KAPR</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">angle between the tool cutting edge plane and the tool feed plane measured in a plane parallel the xy-plane.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_L">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">L</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">theoretical length of the cutting edge of a cutting item over sharp corners.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_LBX">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">LBX</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">distance measured along the X axis from that point of the item closest to the workpiece, including the cutting item for a tool item but excluding a protruding locking mechanism for an adaptive item, to either the front of the flange on a flanged body or the beginning of the connection interface feature on the machine side for cylindrical or prismatic shanks.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_LF">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">LF</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">distance from the gauge plane or from the end of the shank to the furthest point on the tool, if a gauge plane does not exist, to the cutting reference point determined by the main function of the tool. 

The CuttingTool functional length will be the length of the entire tool, not a single cutting item. Each CuttingItem can have an independent FunctionalLength represented in its measurements.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_LFx">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">LFx</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">distance from the gauge plane or from the end of the shank of the cutting tool, if a gauge plane does not exist, to the cutting reference point determined by the main function of the tool. 

This measurement will be with reference to the cutting tool and **MUST NOT** exist without a cutting tool.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_LPR">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">LPR</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">dimension from the yz-plane to the furthest point of the tool item or adaptive item measured in the -X direction.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_LS">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">LS</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">dimension of the length of the shank.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_LUX">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">LUX</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">maximum length of a cutting tool that can be used in a particular cutting operation including the non-cutting portions of the tool.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_NA">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">N/A</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">angle of the tool with respect to the workpiece for a given process. 

The value is application specific.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_OAL">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">OAL</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">largest length dimension of the cutting tool including the master insert where applicable.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_PSIR">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">PSIR</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">angle between the tool cutting edge plane and a plane perpendicular to the tool feed plane measured in a plane parallel the xy-plane.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_RE">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">RE</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">nominal radius of a rounded corner measured in the X Y-plane.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_SDLx">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">SDLx</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">length of a portion of a stepped tool that is related to a corresponding cutting diameter measured from the cutting reference point of that cutting diameter to the point on the next cutting edge at which the diameter starts to change.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_SIG">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">SIG</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">angle between the major cutting edge and the same cutting edge rotated by 180 degrees about the tool axis.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_STAx">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">STAx</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">angle between a major edge on a step of a stepped tool and the same cutting edge rotated 180 degrees about its tool axis.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_W1">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">W1</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">insert width when an inscribed circle diameter is not practical.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_WF">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">WF</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">distance between the cutting reference point and the rear backing surface of a turning tool or the axis of a boring bar.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CodeEnum_WT">
		<rdf:type rdf:resource="&mtc-cnstr;CodeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">WT</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">total weight of the cutting tool in grams. 

The force exerted by the mass of the cutting tool.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:Class rdf:about="&mtc-cnstr;Communications">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;ConditionObservation"/>
		<rdfs:label rdf:datatype="&xs;string">communications</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/ConditionTypes/"/>
