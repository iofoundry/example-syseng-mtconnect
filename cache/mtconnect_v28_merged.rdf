		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">set of limits that is used to indicate whether a process variable is stable and in control.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;Controller">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;SystemComponent"/>
