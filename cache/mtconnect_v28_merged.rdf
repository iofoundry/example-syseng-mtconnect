	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;DataRange">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;ConditionObservation"/>
		<rdfs:label rdf:datatype="&xs;string">data range</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/ConditionTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;ConditionObservation">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;ConditionEnum_DATARANGE"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
						<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ProcessExcursion"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">DataRange</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Condition DataRange</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">indication that the value of the data associated with a measured value or a calculation is outside of an expected range.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
