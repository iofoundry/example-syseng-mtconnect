		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">name of the manufacturer of the physical or logical part of a piece of equipment represented by this element.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&mtc-cnstr;hasMaximum">
		<rdfs:label rdf:datatype="&xs;string">has maximum</rdfs:label>
		<rdfs:domain rdf:resource="&mtc-cnstr;Specification"/>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/Specifications/"/>
		<rdfs:range rdf:resource="&mtc-cnstr;Maximum"/>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasMaximumValue">
		<rdfs:label rdf:datatype="&xs;string">has maximum value</rdfs:label>
		<rdfs:domain rdf:resource="&mtc-cnstr;Constraints"/>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/"/>
		<rdfs:range rdf:resource="&xs;float"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">numeric upper constraint.

If the data reported for a data item is a range of numeric values, the expected value reported **MAY** be described with an upper limit defined by this constraint.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasMeasurementIdValue">
		<rdfs:label rdf:datatype="&xs;string">has measurement id value</rdfs:label>
		<rdfs:domain rdf:resource="&mtc-cnstr;FeatureMeasurementResult"/>
