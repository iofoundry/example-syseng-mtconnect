	<owl:NamedIndividual rdf:about="&mtc-cnstr;ValveStateEnum_OPEN">
		<rdf:type rdf:resource="&mtc-cnstr;ValveStateEnum"/>
		<rdfs:label rdf:datatype="&xs;string">OPEN</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">valve state where flow is allowed and the aperture is static.

&gt; Note: For a binary value, `OPEN` indicates the valve has the maximum possible aperture.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;ValveStateEnum_OPENING">
		<rdf:type rdf:resource="&mtc-cnstr;ValveStateEnum"/>
