	<owl:NamedIndividual rdf:about="&mtc-cnstr;ValveStateEnum_CLOSED">
		<rdf:type rdf:resource="&mtc-cnstr;ValveStateEnum"/>
		<rdfs:label rdf:datatype="&xs;string">CLOSED</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">valve state where flow is not possible, the aperture is static, and the valve is completely shut.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;ValveStateEnum_CLOSING">
		<rdf:type rdf:resource="&mtc-cnstr;ValveStateEnum"/>
		<rdfs:label rdf:datatype="&xs;string">CLOSING</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">valve is transitioning from an `OPEN` state to a `CLOSED` state.</iof-av:naturalLanguageDefinition>
