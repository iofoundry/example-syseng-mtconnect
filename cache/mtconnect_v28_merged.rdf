			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;WaitStateEnum_PARTLOAD">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;WaitStateEnum_PARTUNLOAD">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;WaitStateEnum_TOOLLOAD">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;WaitStateEnum_TOOLUNLOAD">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;WaitStateEnum_MATERIALLOAD">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;WaitStateEnum_MATERIALUNLOAD">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;WaitStateEnum_SECONDARYPROCESS">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;WaitStateEnum_PAUSING">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;WaitStateEnum_RESUMING">
			</rdf:Description>
