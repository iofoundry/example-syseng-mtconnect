		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<rdfs:range rdf:resource="&xs;string"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">last date/time stamp that maintenance was performed.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
