	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasDiscreteValue">
		<rdfs:label rdf:datatype="&xs;string">has discrete value</rdfs:label>
		<rdfs:domain rdf:resource="&mtc-cnstr;DataItem"/>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataItems/"/>
		<rdfs:range rdf:resource="&xs;boolean"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">indication signifying whether each value reported for the {{term(Observation)}} is significant and whether duplicate values are to be suppressed.

If a value is not defined for {{property(DataItem::discrete)}}, the default value **MUST** be `false`.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasDistrictValue">
		<rdfs:label rdf:datatype="&xs;string">has district value</rdfs:label>
		<rdfs:domain rdf:resource="&mtc-cnstr;LocationAddressResult"/>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<rdfs:range rdf:resource="&xs;string"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">element indicating the name of the area within or adjacent to the town in which a delivery point is located, or via which it is accessed.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasDoorValue">
		<rdfs:label rdf:datatype="&xs;string">has door value</rdfs:label>
		<rdfs:domain rdf:resource="&mtc-cnstr;LocationAddressResult"/>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<rdfs:range rdf:resource="&xs;string"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">element indicating the apartment, room or office in, at or adjacent to which a delivery point, situated within a building, is located.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasDurationValue">
