	<owl:Class rdf:about="&mtc-cnstr;SensingElement">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/SensorSpecification"/>
		<rdfs:label rdf:datatype="&xs;string">sensing element</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/ComponentTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;Component">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
						<owl:someValuesFrom rdf:resource="&mtc-cnstr;SensingElementEntity"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasComposition"/>
						<owl:someValuesFrom rdf:resource="&mtc-cnstr;Composition"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
						<owl:someValuesFrom rdf:resource="&mtc-cnstr;Component"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">SensingElement</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Component SensingElement</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">leaf component that provides a signal or measured value.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;SensingElementEntity">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DetectingDevice"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
				<owl:someValuesFrom rdf:resource="&mtc-cnstr;ComponentEntity"/>
			</owl:Restriction>
