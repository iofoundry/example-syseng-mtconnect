	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasDataItemIdValue">
		<rdfs:label rdf:datatype="&xs;string">has data item id value</rdfs:label>
		<rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/"/>
		<rdfs:range rdf:resource="&xs;string"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">unique identifier of the {{block(DataItem)}} associated with this {{block(Observation)}}.

{{property(Observation::dataItemId)}} **MUST** match the associated {{property(DataItem::id)}} defined in the {{term(MTConnectDevices Response Document)}}.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
