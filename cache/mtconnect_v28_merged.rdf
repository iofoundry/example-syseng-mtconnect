	<owl:Class rdf:about="&mtc-cnstr;UnloadCount">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;EventObservation"/>
		<rdfs:label rdf:datatype="&xs;string">unload count</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/EventTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;EventObservation">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasSubType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;DataItemSubTypeEnum_ALL"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;EventEnum_UNLOADCOUNT"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
						<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/PerformanceIndicator"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasResultValue"/>
						<owl:someValuesFrom rdf:resource="&xs;integer"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">UnloadCount</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Event UnloadCount</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">accumulation of the number of times an operation has attempted to, or is planned to attempt to, unload materials, parts, or other items.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;UnloadCountAborted">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;UnloadCount"/>
		<rdfs:label rdf:datatype="&xs;string">unload count aborted</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/EventTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;UnloadCount">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasSubType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;DataItemSubTypeEnum_ABORTED"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
						<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Event"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">UnloadCount.Aborted</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Event UnloadCount.Aborted</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">accumulation of actions or activities that were attempted, but terminated before they could be completed.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
