		</owl:oneOf>
	</owl:Class>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionStateVerticalEnum_DOWN">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionStateVerticalEnum"/>
		<rdfs:label rdf:datatype="&xs;string">DOWN</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">position of the composition element is oriented in a downward direction to the point of a positive confirmation.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionStateVerticalEnum_TRANSITIONING">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionStateVerticalEnum"/>
		<rdfs:label rdf:datatype="&xs;string">TRANSITIONING</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">position of the composition element is not oriented in an upward direction to the point of a positive confirmation and is not oriented in a downward direction to the point of a positive confirmation. 

It is in an intermediate position.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;CompositionStateVerticalEnum_UP">
		<rdf:type rdf:resource="&mtc-cnstr;CompositionStateVerticalEnum"/>
		<rdfs:label rdf:datatype="&xs;string">UP</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">position of the composition element is oriented in an upward direction to the point of a positive confirmation.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
