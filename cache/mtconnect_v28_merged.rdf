					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000110"/>
						<owl:someValuesFrom rdf:resource="&mtc-cnstr;Component"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">RemovalPot</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Component RemovalPot</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">leaf component that is a pot for a tool that has to be removed from a tool magazine or turret to a location outside of the piece of equipment.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;RemovalPotEntity">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Container"/>
