		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">requester is prepared to make a request, but no request for service is required.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
