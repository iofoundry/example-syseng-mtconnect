		<owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
		<skos:definition rdf:datatype="&rdf;langString" xml:lang="en">b continuant part of c at some time =Def for some time t (b exists at t and c exists at t and b continuant part of c at t &amp; t is a temporal region &amp; b and c are continuants)</skos:definition>
		<skos:example rdf:datatype="&rdf;langString" xml:lang="en">Milk teeth continuant part of human at some time; surgically removed tumour continuant part of organism at some time.</skos:example>
		<skos:prefLabel rdf:datatype="&rdf;langString" xml:lang="en">continuant part of at some time</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000177">
		<rdf:type rdf:resource="&owl;TransitiveProperty"/>
		<rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000176"/>
		<rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">continuant part of at all times</rdfs:label>
		<dc:identifier rdf:datatype="&xs;string">222-BFO</dc:identifier>
