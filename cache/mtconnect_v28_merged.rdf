		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
				<owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&xs;string">abstract translation</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/"/>
