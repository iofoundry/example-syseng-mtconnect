	<owl:Class rdf:about="&mtc-cnstr;Uncertainty">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;EventObservation"/>
		<rdfs:label rdf:datatype="&xs;string">uncertainty</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/EventTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;EventObservation">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;EventEnum_UNCERTAINTY"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasResultValue"/>
						<owl:someValuesFrom rdf:resource="&xs;double"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">Uncertainty</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Event Uncertainty</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">uncertainty specified by uncertainty type.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;UncertaintyType">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;EventObservation"/>
		<rdfs:label rdf:datatype="&xs;string">uncertainty type</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/EventTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;EventObservation">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;EventEnum_UNCERTAINTYTYPE"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
						<owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasResult"/>
						<owl:someValuesFrom rdf:resource="&mtc-cnstr;UncertaintyTypeEnum"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">UncertaintyType</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Event UncertaintyType</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">method used to compute standard uncertainty.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
