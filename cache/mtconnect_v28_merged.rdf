		<rdfs:range rdf:resource="&xs;string"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">specifies the language of the alarm text.

See {{cite(IETF RFC 4646)}} (http://www.ietf.org/rfc/rfc4646.txt).</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasLastServiceDateValue">
		<rdfs:label rdf:datatype="&xs;string">has last service date value</rdfs:label>
