		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Sample</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">observation that is continuously changing or analog data value.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
