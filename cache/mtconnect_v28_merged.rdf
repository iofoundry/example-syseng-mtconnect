		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">system that provides regulation or management of a system or component. &lt;em&gt;ISO 16484-5:2017&lt;/em&gt;</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
