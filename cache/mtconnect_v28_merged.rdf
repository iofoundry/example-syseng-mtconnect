			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;CoordinateSystemTypeEnum_TASK">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;CoordinateSystemTypeEnum_MECHANICALINTERFACE">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;CoordinateSystemTypeEnum_TOOL">
			</rdf:Description>
