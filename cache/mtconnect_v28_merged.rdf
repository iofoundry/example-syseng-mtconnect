		<rdfs:label rdf:datatype="&xs;string">TOOL_LOAD</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">execution is waiting while a tool or tooling is being loaded.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;WaitStateEnum_TOOLUNLOAD">
		<rdf:type rdf:resource="&mtc-cnstr;WaitStateEnum"/>
		<rdfs:label rdf:datatype="&xs;string">TOOL_UNLOAD</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
