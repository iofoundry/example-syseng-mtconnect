	<owl:NamedIndividual rdf:about="&mtc-cnstr;DataItemSubTypeEnum_ABORTED">
		<rdf:type rdf:resource="&mtc-cnstr;DataItemSubTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">ABORTED</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">actions or activities that were attempted, but terminated before they could be completed.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;DataItemSubTypeEnum_ABSOLUTE">
		<rdf:type rdf:resource="&mtc-cnstr;DataItemSubTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">ABSOLUTE</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">relating to or derived in the simplest manner from the fundamental units or measurements.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;DataItemSubTypeEnum_ACTION">
		<rdf:type rdf:resource="&mtc-cnstr;DataItemSubTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">ACTION</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">indication of the operating state of a mechanism.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;DataItemSubTypeEnum_ACTIVE">
		<rdf:type rdf:resource="&mtc-cnstr;DataItemSubTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">ACTIVE</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">relating to logic or motion program currently executing.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;DataItemSubTypeEnum_ACTIVITY">
		<rdf:type rdf:resource="&mtc-cnstr;DataItemSubTypeEnum"/>
		<rdfs:label rdf:datatype="&xs;string">ACTIVITY</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
