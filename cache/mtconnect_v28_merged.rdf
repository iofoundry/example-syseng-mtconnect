		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
				<owl:someValuesFrom rdf:resource="https://www.omg.org/spec/Commons/Collections/StructuredCollection"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label rdf:datatype="&xs;string">data set</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/Representations/"/>
		<skos:altLabel rdf:datatype="&xs;string">DataSet</skos:altLabel>
		<mtc-cnstr:iofParentCandidate rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementInformationContentEntity"/>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Representation DataSet</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">representation for an observation composed of value(s) represented as a set of key-value pairs.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
