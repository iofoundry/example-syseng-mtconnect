			<owl:Restriction>
				<owl:onProperty rdf:resource="&mtc-cnstr;hasCountValue"/>
				<owl:someValuesFrom rdf:resource="&xs;integer"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&mtc-cnstr;hasResult"/>
				<owl:someValuesFrom rdf:resource="&mtc-cnstr;EntryRepresentations"/>
			</owl:Restriction>
