		<rdfs:range rdf:resource="&xs;string"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">most accurate time available to a piece of equipment that represents the point in time that the data reported was measured.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasTownValue">
		<rdfs:label rdf:datatype="&xs;string">has town value</rdfs:label>
		<rdfs:domain rdf:resource="&mtc-cnstr;LocationAddressResult"/>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<rdfs:range rdf:resource="&xs;string"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">element indicating the name of the populated place in which a delivery point is located, or the populated.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
