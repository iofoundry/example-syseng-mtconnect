		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/SampleTypes/"/>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Sample YDimension</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">dimension of an entity relative to the Y direction of the referenced coordinate system.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;ZDimension">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Observation"/>
		<rdfs:label rdf:datatype="&xs;string">z dimension</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/SampleTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;SampleObservation">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasUnits"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;UnitEnum_MILLIMETER"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;SampleEnum_ZDIMENSION"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
						<owl:someValuesFrom rdf:resource="&mtc-cnstr;ZDimensionQuality"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">ZDimension</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Sample ZDimension</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">dimension of an entity relative to the Z direction of the referenced coordinate system.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;ZDimensionQuality">
		<rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Length"/>
		<rdfs:label rdf:datatype="&xs;string">z dimension quality</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/SampleTypes/"/>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Sample ZDimension</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">dimension of an entity relative to the Z direction of the referenced coordinate system.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
