	<owl:Class rdf:about="&mtc-cnstr;FunctionalModeEnum">
		<rdfs:label rdf:datatype="&xs;string">functional mode enum</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
