		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;Component">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
						<owl:someValuesFrom rdf:resource="&mtc-cnstr;DoorEntity"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;observes"/>
						<owl:someValuesFrom rdf:resource="&mtc-cnstr;DoorState"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">Door</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Component Door</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">component composed of a mechanical mechanism or closure that can cover a physical access portal into a piece of equipment allowing or restricting access to other parts of the equipment.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
