		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">`MASS` times `GRAVITATIONAL_ACCELERATION`  (g).</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
