		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;EventObservation">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasSubType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;DataItemSubTypeEnum_ALL"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;EventEnum_DEACTIVATIONCOUNT"/>
