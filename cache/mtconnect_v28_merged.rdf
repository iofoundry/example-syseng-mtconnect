					<owl:Restriction>
						<owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
						<owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/FailureEvent"/>
