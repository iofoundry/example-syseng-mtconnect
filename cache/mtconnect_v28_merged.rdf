		<skos:definition rdf:datatype="&rdf;langString" xml:lang="en">b environs c =Def c occurs in b</skos:definition>
		<skos:example rdf:datatype="&rdf;langString" xml:lang="en">Mouth environs process of mastication, city environs traffic.</skos:example>
		<skos:prefLabel rdf:datatype="&rdf;langString" xml:lang="en">environs</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000184">
