		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">either a single multiplier applied to all three dimensions or a three space multiplier given in the X, Y, and Z dimensions in the coordinate system used for the solid model.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;AbstractTranslation">
