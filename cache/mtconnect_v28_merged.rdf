		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">reference system that associates a unique set of n parameters with each point in an n-dimensional space. &lt;em&gt;ISO 10303-218:2004&lt;/em&gt;</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;CoordinateSystemEnum">
		<rdfs:label rdf:datatype="&xs;string">coordinate system enum</rdfs:label>
