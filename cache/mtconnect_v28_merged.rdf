	<owl:Class rdf:about="&mtc-cnstr;EndOfBar">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;EventObservation"/>
		<rdfs:label rdf:datatype="&xs;string">end of bar</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/EventTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;EventObservation">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;EventEnum_ENDOFBAR"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasSubType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;DataItemSubTypeEnum_PRIMARY"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasResult"/>
						<owl:someValuesFrom rdf:resource="&mtc-cnstr;EndOfBarEnum"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">EndOfBar</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Event EndOfBar</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">indication of whether the end of a piece of bar stock being feed by a bar feeder has been reached.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;EndOfBarAuxiliary">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;EndOfBar"/>
		<rdfs:label rdf:datatype="&xs;string">end of bar auxiliary</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/EventTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;EndOfBar">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasSubType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;DataItemSubTypeEnum_AUXILIARY"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">EndOfBar.Auxiliary</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Event EndOfBar.Auxiliary</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">when multiple locations on a piece of bar stock are referenced as the indication for the end of bar, the additional location(s) **MUST** be designated as `AUXILIARY` indication(s) for the end of bar.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&mtc-cnstr;EndOfBarEnum">
		<rdfs:label rdf:datatype="&xs;string">end of bar enum</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<owl:oneOf rdf:parseType="Collection">
			<rdf:Description rdf:about="&mtc-cnstr;EndOfBarEnum_YES">
			</rdf:Description>
			<rdf:Description rdf:about="&mtc-cnstr;EndOfBarEnum_NO">
			</rdf:Description>
		</owl:oneOf>
	</owl:Class>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;EndOfBarEnum_NO">
		<rdf:type rdf:resource="&mtc-cnstr;EndOfBarEnum"/>
		<rdfs:label rdf:datatype="&xs;string">NO</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">end of bar has not been reached.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;EndOfBarEnum_YES">
		<rdf:type rdf:resource="&mtc-cnstr;EndOfBarEnum"/>
		<rdfs:label rdf:datatype="&xs;string">YES</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">end of bar has been reached.</iof-av:naturalLanguageDefinition>
	</owl:NamedIndividual>
	
	<owl:Class rdf:about="&mtc-cnstr;EndOfBarPrimary">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;EndOfBar"/>
		<rdfs:label rdf:datatype="&xs;string">end of bar primary</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/EventTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;EndOfBar">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasSubType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;DataItemSubTypeEnum_PRIMARY"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">EndOfBar.Primary</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Event EndOfBar.Primary</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">specific applications **MAY** reference one or more locations on a piece of bar stock as the indication for the end of bar. 

The main or most important location **MUST** be designated as the PRIMARY indication for the end of bar.

If no subType is specified, PRIMARY **MUST** be the default end of bar indication.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
