					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasSubType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;DataItemSubTypeEnum_ABORTED"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">DeactivationCount.Aborted</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Event DeactivationCount.Aborted</iof-av:directSource>
