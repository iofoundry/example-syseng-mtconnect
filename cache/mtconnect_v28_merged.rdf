		<rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
		<owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000174"/>
		<skos:definition rdf:datatype="&rdf;langString" xml:lang="en">b proper continuant part of c at some time =Def for some time t (b continuant part of c at t &amp; not (c continuant part of b at t)</skos:definition>
