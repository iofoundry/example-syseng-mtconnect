	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&mtc-cnstr;AxisCouplingEnum_SYNCHRONOUS">
		<rdf:type rdf:resource="&mtc-cnstr;AxisCouplingEnum"/>
		<rdfs:label rdf:datatype="&xs;string">SYNCHRONOUS</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
