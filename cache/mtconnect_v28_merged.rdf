		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Sample ObservationUpdateRate</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">average rate of change of values for data items in the MTConnect streams. The average is computed over a rolling window defined by the implementation.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
