		<skos:definition rdf:datatype="&rdf;langString" xml:lang="en">(Elucidation) b history of c if c is a material entity and b is a history that is the unique history of c</skos:definition>
		<skos:example rdf:datatype="&rdf;langString" xml:lang="en">This life is the history of this organism.</skos:example>
		<skos:prefLabel rdf:datatype="&rdf;langString" xml:lang="en">history of</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000185">
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">has history</rdfs:label>
		<dc:identifier rdf:datatype="&xs;string">145-BFO</dc:identifier>
		<rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
		<rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000182"/>
		<owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000184"/>
		<skos:definition rdf:datatype="&rdf;langString" xml:lang="en">b has history c =Def c history of b</skos:definition>
		<skos:example rdf:datatype="&rdf;langString" xml:lang="en">This organism has history this life.</skos:example>
		<skos:prefLabel rdf:datatype="&rdf;langString" xml:lang="en">has history</skos:prefLabel>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000194">
		<rdfs:label rdf:datatype="&rdf;langString" xml:lang="en">specifically depended on by</rdfs:label>
