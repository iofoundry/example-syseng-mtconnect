					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasSubType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;DataItemSubTypeEnum_POWERED"/>
