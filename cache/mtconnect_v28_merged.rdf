	<owl:Class rdf:about="&mtc-cnstr;WaitState">
		<rdfs:subClassOf rdf:resource="&mtc-cnstr;EventObservation"/>
		<rdfs:label rdf:datatype="&xs;string">wait state</rdfs:label>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/EventTypes/"/>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&mtc-cnstr;EventObservation">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasType"/>
						<owl:hasValue rdf:resource="&mtc-cnstr;EventEnum_WAITSTATE"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&mtc-cnstr;hasResult"/>
						<owl:someValuesFrom rdf:resource="&mtc-cnstr;WaitStateEnum"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:altLabel rdf:datatype="&xs;string">WaitState</skos:altLabel>
		<iof-av:directSource rdf:datatype="&xs;string">MTConnect Event WaitState</iof-av:directSource>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">indication of the reason that execution is reporting a value of `WAIT`.

When execution::result is not `WAIT`, observation::isUnavailable of wait state **MUST** be `true`.</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
