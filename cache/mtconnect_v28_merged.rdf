		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">element indicating the floor or level on which a delivery point is located in a multi-story building.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasGivenNameValue">
		<rdfs:label rdf:datatype="&xs;string">has given name value</rdfs:label>
		<rdfs:domain rdf:resource="&mtc-cnstr;LocationAddressResult"/>
		<rdfs:isDefinedBy rdf:resource="https://model.mtconnect.org/ontology/machinetool/DataTypes/"/>
		<rdfs:range rdf:resource="&xs;string"/>
		<iof-av:naturalLanguageDefinition rdf:datatype="&xs;string">element specifying the name used to distinguish between persons having the same surname(s) and who may have access to a particular delivery point.</iof-av:naturalLanguageDefinition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&mtc-cnstr;hasHashValue">
